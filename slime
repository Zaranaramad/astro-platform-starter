<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Slime Store</title>
  <meta name="description" content="Handmade slime shop with unique textures, scents, and colors." />
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --bg: #fafafa; --card:#ffffff; --accent:#f472b6; --muted:#6b7280; }
    html { font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
    .gradient-text { background: linear-gradient(90deg, #f472b6, #a78bfa); -webkit-background-clip: text; background-clip: text; color: transparent; }
  </style>
</head>
<body class="bg-[var(--bg)] text-gray-900">
  <!-- Header -->
  <header class="max-w-6xl mx-auto px-4 py-6 flex items-center justify-between">
    <a href="#" class="flex items-center gap-2 font-bold text-lg">
      <span class="inline-flex h-8 w-8 rounded-xl bg-pink-400/20 ring-1 ring-pink-300/30 items-center justify-center">🧋</span>
      <span>Slime Haven</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm text-gray-600">
      <a href="#shop" class="hover:text-pink-500">Shop</a>
      <a href="#how" class="hover:text-pink-500">How It’s Made</a>
      <a href="#faq" class="hover:text-pink-500">FAQ</a>
    </nav>
    <a href="#cta" class="px-4 py-2 rounded-xl bg-pink-400 text-white hover:bg-pink-500">Order Now</a>
  </header>

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 mt-8 md:mt-16">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <p class="uppercase tracking-wide text-xs text-pink-500/80">Handmade • Fun • Stress-Relief</p>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mt-2">
          The <span class="gradient-text">slimiest</span> shop online
        </h1>
        <p class="text-gray-600 mt-4 max-w-xl">
          Shop handmade slime with unique textures, scents, and colors. Perfect for play, stress relief, and collecting.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 mt-6">
          <a href="#shop" class="px-5 py-3 rounded-2xl bg-pink-500 text-white font-semibold hover:bg-pink-600">Shop Slime</a>
          <a href="#cta" class="px-5 py-3 rounded-2xl ring-1 ring-pink-400 text-pink-500 hover:bg-pink-50">Custom Orders</a>
        </div>
      </div>
      <div class="relative">
        <img src="https://images.unsplash.com/photo-1612197529865-df83a25d816f" alt="Colorful slime jars" class="rounded-3xl shadow-lg" />
      </div>
    </div>
  </section>

  <!-- Shop -->
  <section id="shop" class="max-w-6xl mx-auto px-4 mt-16">
    <h2 class="text-3xl md:text-4xl font-extrabold">Our Bestsellers</h2>
    <div class="mt-6 grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl p-6 bg-[var(--card)] shadow">
        <img src="https://images.unsplash.com/photo-1609424032796-29f0f5d34ddc" alt="Fluffy slime" class="rounded-xl mb-3" />
        <h3 class="text-xl font-bold">Fluffy Cotton Candy</h3>
        <p class="text-gray-600 mt-2">Super airy and soft with a sweet cotton candy scent.</p>
        <p class="font-semibold mt-2">$9.99</p>
      </div>
      <div class="rounded-2xl p-6 bg-[var(--card)] shadow">
        <img src="https://images.unsplash.com/photo-1623856929962-d37e04f244b5" alt="Butter slime" class="rounded-xl mb-3" />
        <h3 class="text-xl font-bold">Butter Slime</h3>
        <p class="text-gray-600 mt-2">Smooth and spreadable, feels like butter in your hands.</p>
        <p class="font-semibold mt-2">$11.99</p>
      </div>
      <div class="rounded-2xl p-6 bg-[var(--card)] shadow">
        <img src="https://images.unsplash.com/photo-1631864019979-fd9af70906cb" alt="Clear slime" class="rounded-xl mb-3" />
        <h3 class="text-xl font-bold">Crystal Clear</h3>
        <p class="text-gray-600 mt-2">Satisfying clear slime, perfect for add-ins and stretching.</p>
        <p class="font-semibold mt-2">$8.99</p>
      </div>
    </div>
  </section>

  <!-- How it Works -->
  <section id="how" class="max-w-6xl mx-auto px-4 mt-16">
    <h2 class="text-3xl md:text-4xl font-extrabold">How we make our slime</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-6">
      <div class="rounded-2xl p-6 bg-[var(--card)] shadow">
        <p class="text-5xl">🧴</p>
        <h4 class="font-bold mt-2">Safe Ingredients</h4>
        <p class="text-gray-600 text-sm mt-1">Made with kid-safe glue, borax activator, and cosmetic-grade scents.</p>
      </div>
      <div class="rounded-2xl p-6 bg-[var(--card)] shadow">
        <p class="text-5xl">🎨</p>
        <h4 class="font-bold mt-2">Unique Colors</h4>
        <p class="text-gray-600 text-sm mt-1">Each batch is tinted and mixed by hand for vibrant designs.</p>
      </div>
      <div class="rounded-2xl p-6 bg-[var(--card)] shadow">
        <p class="text-5xl">✨</p>
        <h4 class="font-bold mt-2">Textures & Add‑Ins</h4>
        <p class="text-gray-600 text-sm mt-1">From fluffy to crunchy, we create slimes that feel amazing.</p>
      </div>
    </div>
  </section>

  <!-- Lead Capture / CTA -->
  <section id="cta" class="max-w-6xl mx-auto px-4 mt-16 mb-24">
    <div class="rounded-3xl p-6 md:p-10 bg-pink-50 shadow">
      <h3 class="text-2xl font-extrabold text-pink-600">Custom Order Request</h3>
      <p class="text-gray-600 mt-2">Want a slime with your favorite color, texture, or scent? Request it here!</p>
      <form id="leadForm" class="mt-6 space-y-4">
        <div>
          <label for="name" class="text-sm text-gray-600">Name</label>
          <input id="name" name="name" required class="mt-1 w-full rounded-xl border border-gray-300 px-4 py-3" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="text-sm text-gray-600">Email</label>
          <input id="email" name="email" type="email" required class="mt-1 w-full rounded-xl border border-gray-300 px-4 py-3" placeholder="you@email.com" />
        </div>
        <div>
          <label for="need" class="text-sm text-gray-600">Your Custom Request</label>
          <textarea id="need" name="need" rows="4" required class="mt-1 w-full rounded-xl border border-gray-300 px-4 py-3" placeholder="e.g., Pink butter slime with bubblegum scent"></textarea>
        </div>
        <button class="w-full px-5 py-3 rounded-2xl bg-pink-500 text-white font-semibold hover:bg-pink-600">Send Request</button>
        <p id="thanks" class="hidden text-sm text-green-600">Thanks! Your request was sent.</p>
      </form>
    </div>
  </section>

  <footer class="max-w-6xl mx-auto px-4 pb-12 text-xs text-gray-500">
    <p>© <span id="year"></span> Slime Haven • Handmade slimes with love.</p>
  </footer>

  <script>
    const form = document.getElementById('leadForm');
    const thanks = document.getElementById('thanks');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const valid = form.checkValidity();
      if (!valid) { form.reportValidity(); return; }
      thanks.classList.remove('hidden');
      form.reset();
      setTimeout(() => thanks.classList.add('hidden'), 4000);
    });
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
